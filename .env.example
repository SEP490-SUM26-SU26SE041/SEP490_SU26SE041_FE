# Mẫu biến môi trường cho FE - copy thành .env.local khi dev, hoặc cấu hình trong Vercel Dashboard khi deploy.
# Vite chỉ expose biến VITE_* cho client.

# Base URL cho backend API. Bỏ /api nếu backend đã thêm sẵn prefix.
VITE_API_BASE_URL=https://smartfarm-sep490-api-c3emdvfmdefybacs.eastasia-01.azurewebsites.net/api

# Domain backend gốc (không kèm /api) - dùng khi cần call trực tiếp tới các endpoint không có prefix.
VITE_API_ORIGIN=https://smartfarm-sep490-api-c3emdvfmdefybacs.eastasia-01.azurewebsites.net

# Google OAuth Client ID (nếu dùng tính năng Google Login)
VITE_GOOGLE_CLIENT_ID=
